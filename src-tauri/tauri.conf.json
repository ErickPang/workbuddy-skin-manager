{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Theme Manager",
  "version": "../package.json",
  "identifier": "com.moxiangyijing.workbuddy-theme-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy Theme Manager",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/themes/**/*.png",
          "$APPDATA/themes/**/*.jpg",
          "$APPDATA/themes/**/*.jpeg",
          "$APPDATA/themes/**/*.webp",
          "$APPDATA/themes/**/*.PNG",
          "$APPDATA/themes/**/*.JPG",
          "$APPDATA/themes/**/*.JPEG",
          "$APPDATA/themes/**/*.WEBP",
          "$RESOURCE/preset-themes/**/*.png",
          "$RESOURCE/preset-themes/**/*.jpg",
          "$RESOURCE/preset-themes/**/*.jpeg",
          "$RESOURCE/preset-themes/**/*.webp",
          "$RESOURCE/resources/preset-themes/**/*.png",
          "$RESOURCE/resources/preset-themes/**/*.jpg",
          "$RESOURCE/resources/preset-themes/**/*.jpeg",
          "$RESOURCE/resources/preset-themes/**/*.webp"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "墨香异境",
    "category": "Productivity",
    "copyright": "Copyright © 2026 墨香异境",
    "shortDescription": "Generate, import, and manage WorkBuddy themes locally.",
    "longDescription": "WorkBuddy Theme Manager is a local desktop tool for non-technical users. Generate themes from images, import .wbskin packages, apply them through a local CDP session, and automatically restore the active theme after reloads.",
    "licenseFile": "../LICENSE",
    "resources": [
      "resources/theme-engine/package.json",
      "resources/theme-engine/runner.js",
      "resources/theme-engine/cdp-client.js",
      "resources/theme-engine/workbuddy-theme.js",
      "resources/preset-themes/*/manifest.json",
      "resources/preset-themes/*/theme.json",
      "resources/preset-themes/*/assets/*.png"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
